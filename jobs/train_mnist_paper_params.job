#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=mnist_paper
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --array=0-14
#SBATCH --output=logs/mnist_paper_%A_%a.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/UvA_FACT_2025" || exit 1
source activate fact

# Paper parameters: noise=0.5, weight_decay=1.0
# Compare with our original: noise=0.4, weight_decay=0.5

# 3 configs x 5 seeds = 15 jobs
CONFIGS=(
    "configs/mnist_dense_none.yaml"        # baseline (same as before)
    "configs/mnist_dense_noise_paper.yaml" # noise=0.5
    "configs/mnist_dense_wd_paper.yaml"    # wd=1.0
    "configs/mnist_dense_full_paper.yaml"  # noise=0.5, wd=1.0
)

SEEDS=(42 43 44 45 46)

# Calculate config and seed from array task ID
# We only run 3 new configs (skip none which is already done)
# So: 0-4 = noise_paper, 5-9 = wd_paper, 10-14 = full_paper
CONFIG_IDX=$(( (SLURM_ARRAY_TASK_ID / 5) + 1 ))
SEED_IDX=$(( SLURM_ARRAY_TASK_ID % 5 ))

CONFIG=${CONFIGS[$CONFIG_IDX]}
SEED=${SEEDS[$SEED_IDX]}

echo "========================================"
echo "MNIST with Paper Parameters"
echo "Task ID: $SLURM_ARRAY_TASK_ID"
echo "Config: $CONFIG"
echo "Seed: $SEED"
echo "========================================"

python src/train.py \
    --config "$CONFIG" \
    --seed "$SEED" \
    --output-dir "results/phase1_paper/checkpoints"

echo "Done: $(date)"
