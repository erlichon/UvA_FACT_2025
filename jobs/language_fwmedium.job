#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=lang_fwmedium
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=logs/language_fwmedium_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/UvA_FACT_2025" || exit 1
source activate fact

echo "========================================"
echo "Language Experiments with fw-medium"
echo "Date: $(date)"
echo "Host: $(hostname)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "========================================"
echo ""
echo "Configuration:"
echo "  Model: tdooms/fw-medium (FineWeb-EDU trained)"
echo "  SAE: layer 7, expansion 8, k=30"
echo "  (Paper configuration for Section 5)"
echo "========================================"

# Create results directory
mkdir -p results/language

# Step 1: Negation discovery (uses pretrained SAEs)
# echo ""
# echo "========================================"
# echo "Step 1/2: Discovering negation circuits..."
# echo "========================================"
# python src/language/negation_discovery.py \
#     --config configs/language_negation.yaml \
#     --output results/language/negation_analysis_fwmedium.json \
#     --use-pretrained

# Step 2a: Interaction analysis WITHOUT projection (raw Q matrices)
echo ""
echo "========================================"
echo "Step 2a/3: Analyzing interaction matrices (no projection)..."
echo "========================================"
python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --output results/language/interaction_analysis_fwmedium_noproj.json \
    --no-project \
    --no-wandb

# Step 2b: Interaction analysis WITH projection (Q projected onto SAE latents)
echo ""
echo "========================================"
echo "Step 2b/3: Analyzing interaction matrices (with projection)..."
echo "========================================"
python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --output results/language/interaction_analysis_fwmedium_proj.json \
    --project \
    --no-wandb

echo ""
echo "========================================"
echo "fw-medium experiments complete: $(date)"
echo "========================================"
echo ""
echo "Results saved to:"
echo "  - results/language/negation_analysis_fwmedium.json"
echo "  - results/language/interaction_analysis_fwmedium_noproj.json"
echo "  - results/language/interaction_analysis_fwmedium_proj.json"
