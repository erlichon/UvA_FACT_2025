#!/bin/bash
#SBATCH --job-name=lang_interaction_cmp
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=logs/language_interaction_comparison_%j.out
#SBATCH --error=logs/language_interaction_comparison_%j.err

# Language Interaction Analysis Comparison
# Runs both projected and non-projected to compare results

echo "=========================================="
echo "Language Interaction Analysis Comparison"
echo "=========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Start time: $(date)"
echo ""

# Load modules
module load 2025
module load Anaconda3/2025.06-1

# Activate environment
source activate fact

# Navigate to project directory
cd $HOME/UvA_FACT_2025

mkdir -p logs results/language

# Print environment info
echo "CUDA available: $(python -c 'import torch; print(torch.cuda.is_available())')"
echo ""

# Run 1: WITHOUT projection (model space, 1024x1024)
echo "=========================================="
echo "Run 1: Without projection (model space)"
echo "=========================================="
python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --no-project \
    --output results/language/interaction_analysis_unprojected.json \
    --device cuda

echo ""

# Run 2: WITH projection (SAE latent space, 8192x8192)
echo "=========================================="
echo "Run 2: With projection (SAE latent space)"
echo "=========================================="
python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --project \
    --output results/language/interaction_analysis_projected.json \
    --device cuda

echo ""
echo "=========================================="
echo "Comparison Summary"
echo "=========================================="

python -c "
import json

print('Without projection (model space 1024x1024):')
try:
    with open('results/language/interaction_analysis_unprojected.json') as f:
        r1 = json.load(f)
    print(f\"  Mean correlation: {r1.get('mean_correlation', 'N/A'):.4f}\")
    print(f\"  % above 0.75: {r1.get('percent_above_threshold', 'N/A'):.1f}%\")
except Exception as e:
    print(f'  Error: {e}')

print()
print('With projection (SAE space 8192x8192):')
try:
    with open('results/language/interaction_analysis_projected.json') as f:
        r2 = json.load(f)
    print(f\"  Mean correlation: {r2.get('mean_correlation', 'N/A'):.4f}\")
    print(f\"  % above 0.75: {r2.get('percent_above_threshold', 'N/A'):.1f}%\")
except Exception as e:
    print(f'  Error: {e}')

print()
print('Paper target: 69% above 0.75 (with projection)')
"

echo ""
echo "Job completed at: $(date)"
