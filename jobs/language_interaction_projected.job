#!/bin/bash
#SBATCH --job-name=lang_interaction_proj
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/language_interaction_projected_%j.out
#SBATCH --error=logs/language_interaction_projected_%j.err

# Language Interaction Analysis with Projection
# Tests the paper's claim: 69% of features have >0.75 rank-2 correlation
# when Q matrices are projected onto SAE latent space

echo "=========================================="
echo "Language Interaction Analysis (Projected)"
echo "=========================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "Start time: $(date)"
echo ""

# Load modules
module load 2025
module load Anaconda3/2025.06-1

# Activate environment
source activate fact

# Navigate to project directory
cd $HOME/UvA_FACT_2025

# Create logs directory if needed
mkdir -p logs
mkdir -p results/language

# Print environment info
echo "Python: $(which python)"
echo "PyTorch version: $(python -c 'import torch; print(torch.__version__)')"
echo "CUDA available: $(python -c 'import torch; print(torch.cuda.is_available())')"
echo ""

# Run interaction analysis WITH projection
# This projects Q matrices onto SAE latent space (8192x8192)
# Expected runtime: ~3-4 hours for 500 features
echo "Running interaction analysis with --project flag..."
echo ""

python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --project \
    --output results/language/interaction_analysis_projected.json \
    --device cuda

echo ""
echo "=========================================="
echo "Job completed at: $(date)"
echo "=========================================="

# Print summary if results exist
if [ -f results/language/interaction_analysis_projected.json ]; then
    echo ""
    echo "Results summary:"
    python -c "
import json
with open('results/language/interaction_analysis_projected.json') as f:
    results = json.load(f)
print(f\"Features analyzed: {results.get('n_features_analyzed', 'N/A')}\")
print(f\"Mean correlation: {results.get('mean_correlation', 'N/A'):.4f}\")
print(f\"% above 0.75: {results.get('percent_above_threshold', 'N/A'):.1f}%\")
print(f\"Target: 69% above 0.75\")
"
fi
