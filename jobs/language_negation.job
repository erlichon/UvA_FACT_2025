#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=lang_negation
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/language_negation_%j.out
#SBATCH --error=logs/language_negation_%j.err

# Negation Circuit Discovery (Section 5)
# Discovers negation features similar to paper's 3834 (not+negative) and 751 (not+positive)

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/UvA_FACT_2025" || exit 1
source activate fact

echo "========================================"
echo "Negation Circuit Discovery (Section 5)"
echo "Date: $(date)"
echo "Host: $(hostname)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "========================================"

mkdir -p logs results/language

echo "Running negation circuit discovery..."
echo "Using pretrained SAEs from tdooms/fw-medium-scope"

python src/language/negation_discovery.py \
    --config configs/language_negation.yaml \
    --output results/language/negation_analysis.json \
    --use-pretrained

echo "========================================"
echo "Negation analysis complete: $(date)"
echo "========================================"

# Print summary
if [ -f results/language/negation_analysis.json ]; then
    echo ""
    echo "Results summary:"
    python -c "
import json
with open('results/language/negation_analysis.json') as f:
    results = json.load(f)
summary = results.get('summary', results)
print(f\"  Negation features found: {summary.get('n_negation_features', 'N/A')}\")
print(f\"  Top feature similarity: {summary.get('top_similarity', 'N/A'):.4f}\")
"
fi
