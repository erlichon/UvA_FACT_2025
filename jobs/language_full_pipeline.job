#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=lang_full_pipeline
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/language_full_pipeline_%j.out
#SBATCH --error=logs/language_full_pipeline_%j.err

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/UvA_FACT_2025" || exit 1
source activate fact

echo "========================================"
echo "Full Section 5 Pipeline"
echo "Date: $(date)"
echo "Host: $(hostname)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "========================================"

# Create results directory
mkdir -p results/language

# Step 1: Negation discovery (uses pretrained SAEs)
echo ""
echo "========================================"
echo "Step 1/2: Discovering negation circuits..."
echo "========================================"
python src/language/negation_discovery.py \
    --config configs/language_negation.yaml \
    --output results/language/negation_analysis.json \
    --use-pretrained

# Step 2: Interaction analysis
echo ""
echo "========================================"
echo "Step 2/2: Analyzing interaction matrices..."
echo "========================================"
python src/language/interaction_analysis.py \
    --config configs/language_interaction.yaml \
    --output results/language/interaction_analysis.json \
    --device cuda

echo ""
echo "========================================"
echo "Section 5 pipeline complete: $(date)"
echo "========================================"
echo ""
echo "Results saved to:"
echo "  - results/language/negation_analysis.json"
echo "  - results/language/interaction_analysis.json"
